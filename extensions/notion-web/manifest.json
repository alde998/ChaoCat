{
  "manifest_version": 3,
  "name": "Chaos Cat for Notion Web",
  "version": "0.1.0",
  "description": "Chaos Cat layered document interactions for Notion Web.",
  "content_scripts": [
    {
      "matches": [
        "https://www.notion.so/*",
        "https://notion.so/*"
      ],
      "js": [
        "markers.js",
        "behavior-adapter.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://127.0.0.1:44777/*",
    "ws://127.0.0.1:44777/*",
    "http://localhost:44777/*",
    "ws://localhost:44777/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*"
      ],
      "matches": [
        "https://www.notion.so/*",
        "https://notion.so/*"
      ]
    }
  ]
}
